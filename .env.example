# =============================================================================
# 3AM Talks — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.

# --- Existing Services ---
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=3am-talks-rag

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Same project URL as SUPABASE_URL. For VITE_SUPABASE_ANON_KEY use the anon public key from
# Supabase Dashboard → Settings → API (never put the service_role secret in VITE_*).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Public URLs (OAuth redirects)
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:5050

# --- Session Secret (for cookie signing) ---
SESSION_SECRET=change-this-to-a-random-string

# --- LiveKit Voice Agent ---
# Self-hosted dev: install livekit-server, run `livekit-server --dev`
# Cloud: use your LiveKit Cloud project URL and keys
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- ElevenLabs (for STT + TTS in voice agent) ---
ELEVEN_API_KEY=your_elevenlabs_api_key

# Voice worker -> backend internal auth
VOICE_AGENT_SECRET=change-this-to-a-random-string

# --- LLM endpoints (OpenAI-compatible /v1/chat/completions) ---
# Primary: e.g. friend's laptop running Ollama on the LAN or Tailscale.
# If unset, only the fallback is used.
LLM_PRIMARY_URL=http://192.168.x.x:11434/v1/chat/completions
LLM_PRIMARY_API_KEY=ollama

# Fallback: used when the primary is unreachable (connection errors / 5xx).
# COLAB_API_URL / COLAB_API_KEY are read as a backup so existing deployments
# keep working. You can set LLM_FALLBACK_URL/KEY instead for clarity.
COLAB_API_URL=https://your-colab-url/v1/chat/completions
COLAB_API_KEY=EMPTY

# Crisis arbiter (stage 2) model name. Must match the model registered on
# both primary and fallback endpoints. Default: psychocounsel.
CRISIS_ARBITER_MODEL=psychocounsel
